# =============================================================================
# NairaIntel environment variables
# Copy to .env.local (never commit real secrets)
# =============================================================================

# --- Gemini / AI Studio (qualitative market intelligence only) ---
GEMINI_API_KEY=""

# --- App ---
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV=development

# --- Firebase client (Vite-exposed; safe for browser but restrict keys in console) ---
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- Firebase Admin (SERVER ONLY — never expose to the browser) ---
# Full service account JSON as a single-line string.
# Required for ID token verification and protected API routes.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# --- NGX market data (recommended: NGN Market API) ---
# Get a free key: https://ngnmarket.com/developer
# Used for real equity prices (not Gemini).
NGNMARKET_API_KEY=""
